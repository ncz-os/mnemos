# syntax=docker/dockerfile:1
# ─────────────────────────────────────────────────────────────────────────────
# mnemos-enterprise — everything image + ALL persistence backends.
#
# This is the single backend-agnostic image: it carries the drivers for every
# supported backend and you pick one at RUNTIME (no rebuild):
#   • postgres (asyncpg)   — inherited from mnemos-core base deps
#   • sqlite   (aiosqlite) — inherited from the base (default backend)
#   • oracle   (oracledb, thin) ─┐
#   • mysql    (aiomysql)        ├─ added by the driver layer below, all arches
#   • mariadb  (aiomysql)       ─┘
#   • db2      (ibm_db)          — amd64 ONLY, see below
#
# Publishes: ghcr.io/ncz-os/mnemos-enterprise
# Arch:      linux/amd64 + linux/arm64 (single multi-arch manifest, one tag —
#            operator directive 2026-09-10: ONE image, no separate variants).
#
# Policy: ibm_db (Db2) has no arm64 Linux wheel and its sdist fails to build
# there (setup.py references an undefined `arch_` name on arm64 — genuinely
# broken upstream, not just "needs compiling"; verified 2026-09-10 on real
# arm64 hardware, O6N). oracledb (thin mode, pure Python) and aiomysql (pure
# Python, serves both mysql:// and mariadb:// DSNs) were ALSO verified on
# real arm64 hardware that day — including a live query against PYTHIA's
# production Oracle DB from an arm64 host — so there is no reason to gate
# them to amd64 too. TARGETARCH below installs ibm_db only on amd64; arm64
# gets every other backend. This replaces the prior amd64-only policy, which
# assumed (incorrectly, per that verification) that Oracle needed gating for
# the same reason Db2 does.
#
# Built FROM the everything image (already multi-arch) with one driver layer.
# Selects a backend at runtime via MNEMOS_DATABASE_DSN; defaults to Oracle to
# match the canonical PYTHIA deployment.
# ─────────────────────────────────────────────────────────────────────────────
ARG MNEMOS_EVERYTHING_IMAGE=ghcr.io/ncz-os/mnemos:latest
FROM ${MNEMOS_EVERYTHING_IMAGE}

ARG MNEMOS_CORE_REF=unknown
ARG TARGETARCH

LABEL org.opencontainers.image.title="mnemos-enterprise" \
      org.opencontainers.image.description="MNEMOS everything image with ALL persistence backends (postgres + sqlite from base, plus Oracle / MySQL / MariaDB drivers on every arch, and IBM Db2 on amd64 only); backend selected at runtime via MNEMOS_DATABASE_DSN." \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.source="https://github.com/ncz-os/mnemos" \
      org.mnemos.core="${MNEMOS_CORE_REF}" \
      org.mnemos.variant="enterprise"

# Enterprise persistence drivers. oracledb = thin mode by default (no Instant
# Client), works on every arch. aiomysql is pure Python and serves both the
# MySQL 9.0+ and MariaDB 11.x async paths, also every arch. ibm_db bundles
# the Db2 CLI driver during install and ships prebuilt wheels for amd64 only
# (no arm64 Linux wheel; sdist build fails there — see policy note above),
# so it is conditional on TARGETARCH.
RUN python -m pip install --no-cache-dir \
        'oracledb>=4.0.1' \
        'aiomysql>=0.2.0' && \
    if [ "${TARGETARCH:-amd64}" = "amd64" ]; then \
        python -m pip install --no-cache-dir 'ibm_db>=3.2.4'; \
    fi && \
    python -m pip check

# ─── Tunnel agents for /admin/tunnels/* (v6.4.0) ─────────────────────────────
# mnemos/tunnels/{cloudflare,ngrok}_bridge.py shell out to these binaries.
# Without them in the image the tunnel routes return 503 "not installed" —
# correct behaviour, but it makes the feature inert in every container
# deployment, which is the only deployment most operators have.
#
# Installed HERE and only here, deliberately. mnemos-enterprise is the single
# published container image (AGENTS.md: "the ONLY published container image...
# every container deployment gets the full driver set"), so the other
# Dockerfiles are local/CI build targets that nobody deploys from. Adding ~75 MB
# of Go binaries to each of them would grow images no one runs.
#
# Both vendors publish amd64 AND arm64 Linux builds; every URL below was
# verified to return 200 for both arches on 2026-09-14, and the downloaded
# cloudflared binaries confirmed as statically-linked ELF for their target arch.
#
# cloudflared: version-pinned with a per-arch sha256, since Cloudflare publishes
# immutable per-release GitHub assets.
ARG CLOUDFLARED_VERSION=2026.9.1
ARG CLOUDFLARED_SHA256_amd64=03f1f25d1cc93b9ad6c60569d44060bc4f17ed97075760ed8cfca4b12dcd68cc
ARG CLOUDFLARED_SHA256_arm64=3d97437c71848bd8df68041e12436b484a661d95073ea1937f01a845ce88faa3
RUN set -eux; \
    arch="${TARGETARCH:-amd64}"; \
    case "$arch" in \
      amd64) sha="${CLOUDFLARED_SHA256_amd64}" ;; \
      arm64) sha="${CLOUDFLARED_SHA256_arm64}" ;; \
      *) echo "unsupported TARGETARCH for cloudflared: $arch" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/cloudflared \
      "https://github.com/cloudflare/cloudflared/releases/download/${CLOUDFLARED_VERSION}/cloudflared-linux-${arch}"; \
    echo "${sha}  /tmp/cloudflared" | sha256sum -c -; \
    install -m 0755 /tmp/cloudflared /usr/local/bin/cloudflared; \
    rm -f /tmp/cloudflared; \
    cloudflared --version

# ngrok: the official static tarball from ngrok's own host. NOT checksum-pinned,
# and not by oversight — ngrok publishes only a rolling "stable" channel URL per
# arch, with no immutable per-version artifact to pin against, so a hardcoded
# digest would break the build on ngrok's next release rather than protect it.
# Transport integrity is TLS to ngrok's host; `--fail` keeps a proxy error page
# from being unpacked as if it were the archive.
RUN set -eux; \
    arch="${TARGETARCH:-amd64}"; \
    case "$arch" in amd64|arm64) ;; *) echo "unsupported TARGETARCH for ngrok: $arch" >&2; exit 1 ;; esac; \
    curl -fsSL -o /tmp/ngrok.tgz \
      "https://bin.ngrok.com/c/bNyj1mQVY4c/ngrok-v3-stable-linux-${arch}.tgz"; \
    tar -xzf /tmp/ngrok.tgz -C /usr/local/bin ngrok; \
    chmod 0755 /usr/local/bin/ngrok; \
    rm -f /tmp/ngrok.tgz; \
    ngrok --version

# rclone: STYX's personal-Google-Drive destination delegates OAuth and remote
# credentials entirely to this system binary.  Pin immutable upstream release
# archives and verify per-architecture digests before installation.
ARG RCLONE_VERSION=1.75.1
ARG RCLONE_SHA256_amd64=982b5aa772841168f8e380f139e9e787b2a105403e32b94da8676a0e1c0a13ab
ARG RCLONE_SHA256_arm64=03f2504174034b6d004152ed7369251c9a9ec1f7e0836eda420f5c7a5ec0dff9
RUN set -eux; \
    arch="${TARGETARCH:-amd64}"; \
    case "$arch" in \
      amd64) sha="${RCLONE_SHA256_amd64}" ;; \
      arm64) sha="${RCLONE_SHA256_arm64}" ;; \
      *) echo "unsupported TARGETARCH for rclone: $arch" >&2; exit 1 ;; \
    esac; \
    asset="rclone-v${RCLONE_VERSION}-linux-${arch}"; \
    curl -fsSL -o /tmp/rclone.zip \
      "https://github.com/rclone/rclone/releases/download/v${RCLONE_VERSION}/${asset}.zip"; \
    echo "${sha}  /tmp/rclone.zip" | sha256sum -c -; \
    python -m zipfile -e /tmp/rclone.zip /tmp/rclone; \
    install -m 0755 "/tmp/rclone/${asset}/rclone" /usr/local/bin/rclone; \
    rm -rf /tmp/rclone /tmp/rclone.zip; \
    rclone version

# Default to Oracle; override MNEMOS_DATABASE_DSN at runtime to pick any backend.
ENV MNEMOS_PERSISTENCE_BACKEND=oracle

# Inherits VOLUME /data, EXPOSE 5002, HEALTHCHECK, and the uvicorn CMD.
