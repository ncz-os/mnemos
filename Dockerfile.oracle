# MNEMOS-OS Dockerfile — Oracle 23ai-profile image (PYTHIA production).
#
# Extends the default PG-profile Dockerfile with oracledb (Python thin-mode
# driver — no Oracle Instant Client required). asyncpg + libpq5 still
# bundled so PG fallback works for cross-backend parity tests + edge
# profiles, but PYTHIA Oracle is the production target.
#
# Build:
#   docker build -f Dockerfile.oracle -t mnemos-os:oracle .
#
# Run (PYTHIA pythia-oracle at host 192.0.2.67:1521 PDB ORCLPDB1):
#   docker run -d --name mnemos-oracle \
#     --restart=always \
#     -p 5002:5002 \
#     -e MNEMOS_DATABASE_DSN='oracle://mnemos:mnemos_dev@192.0.2.67:1521/ORCLPDB1' \
#     -e MNEMOS_PERSISTENCE_BACKEND=oracle \
#     mnemos-os:oracle

FROM python:3.13-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ libpq-dev curl git && \
    rm -rf /var/lib/apt/lists/*

# Install a versioned uv installer and verify its bytes before execution.
ARG UV_INSTALLER_SHA256=505407eb4b5bec00e0b231c8c86e968ee3f5aa0136d49dd8a541179e7f76ce7d
RUN curl -fsSL -o /tmp/uv-install.sh https://astral.sh/uv/0.5.11/install.sh && \
    echo "${UV_INSTALLER_SHA256}  /tmp/uv-install.sh" | sha256sum -c - && \
    sh /tmp/uv-install.sh && rm /tmp/uv-install.sh
ENV PATH="/root/.local/bin:$PATH"

COPY pyproject.toml .
COPY requirements.txt .

RUN uv pip install --system -r requirements.txt && \
    uv pip install --system "oracledb>=4.0.1"

FROM python:3.13-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 libgomp1 curl && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/lib/python3.13/site-packages /usr/local/lib/python3.13/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

COPY . .

RUN python -m pip install --no-deps --no-build-isolation .

ENV PYTHONUNBUFFERED=1
ENV MNEMOS_PERSISTENCE_BACKEND=oracle
# Authentication enabled by default so the documented `docker run -p 5002:5002`
# form comes up fail-closed; the lifecycle startup check in
# `mnemos.core.network_guard` only allows an unauthenticated, off-host bind
# when `MNEMOS_ALLOW_UNAUTHENTICATED_NETWORK_BIND=1` is set explicitly.
ENV MNEMOS_PROFILE=server
ENV MNEMOS_AUTH_ENABLED=true

RUN useradd --uid 10001 --gid 0 --no-create-home --home-dir /home/mnemos \
      --shell /usr/sbin/nologin mnemos && \
    mkdir -p /home/mnemos /data /opt/mnemos && \
    chown -R 10001:0 /app /home/mnemos /data /opt/mnemos && \
    chmod -R g=u /app /home/mnemos /data /opt/mnemos
USER 10001:0
ENV HOME=/home/mnemos

EXPOSE 5002

# Go through `mnemos serve` so the bind address is validated: it refuses to
# publish an unauthenticated API off-host (set
# MNEMOS_ALLOW_UNAUTHENTICATED_NETWORK_BIND=1 for a deliberate open box).
CMD ["mnemos", "serve", "--host", "0.0.0.0", "--port", "5002"]
