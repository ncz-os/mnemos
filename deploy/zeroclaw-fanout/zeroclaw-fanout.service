[Unit]
Description=Zeroclaw fan-out bootstrap (probe cores+ram, enable @1..@N workers)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/usr/local/sbin/zeroclaw-fanout-init

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/zeroclaw-fanout-init
RemainAfterExit=true

[Install]
WantedBy=multi-user.target
