# ============================================================
# Risk profiles
# ============================================================

[risk_profiles.default]
level = "limited"
workspace_only = true
auto_approve = []

[risk_profiles.hive_worker]
level = "full"
workspace_only = false
auto_approve = ["*"]

# ============================================================
# Runtime profiles
# ============================================================

[runtime_profiles.default]
max_iterations = 50

[runtime_profiles.coordinator]
max_iterations = 200

# ============================================================
# Agents — one per tier, named for hive routing
# ============================================================

# Default hive agent — Tier B Groq qwen3 (existing behavior)
[agents.hive]
risk_profile = "hive_worker"
model_provider = "groq.groq_qwen3"
runtime_profile = "coordinator"
system_prompt = "/no_think\n\nYou are a Hive Mind worker agent. ALWAYS use tools to execute tasks — never describe what you would do, just do it. IMPORTANT: the shell tool does not set PATH. For ALL system commands, use the bash -c form: bash -c \"hostname\", bash -c \"date\", bash -c \"uptime\". Complete the task fully and return the result concisely."
agentic = true

# Tier A — premium quality (Anthropic Opus default)
[agents.hive_tier_a]
risk_profile = "hive_worker"
model_provider = "claude.opus_4_6"
runtime_profile = "coordinator"
system_prompt = "You are a Hive Mind premium-tier agent. Quality-critical task. Use tools to execute completely. Return concise actionable result."
agentic = true

# Tier B — mid (Groq Llama-3.3-70B)
[agents.hive_tier_b]
