model = "meta/llama-3.3-70b-instruct"

# ============================================================
# Risk profiles
# ============================================================

[risk_profiles.hive_worker]
auto_approve = ["file_read", "file_write", "file_delete", "bash", "shell", "memory_recall", "web_search_tool", "web_fetch", "calculator", "glob_search", "content_search"]
workspace_only = false
level = "full"
sandbox_enabled = false
block_high_risk_commands = false
require_approval_for_medium_risk = false
forbidden_paths = []
allowed_roots = ["/home", "/tmp", "/var/tmp"]
allowed_commands = ["git", "npm", "cargo", "ls", "cat", "grep", "find", "echo", "pwd", "wc", "head", "tail", "date", "df", "du", "uname", "uptime", "hostname", "python", "python3", "pip", "node", "free", "sed", "awk", "bash", "sh", "mv", "cp", "mkdir", "rm", "chmod", "tee", "touch", "test", "true", "false"]
shell_env_passthrough = ["PATH", "HOME", "USER", "LANG", "LC_ALL"]

# ============================================================
# Runtime profiles
# ============================================================

[runtime_profiles.coordinator]
agentic = true
max_depth = 5
agentic_timeout_secs = 600

[runtime_profiles.agent_hive]
agentic = true

[runtime_profiles.agent_hive_tier_a]
agentic = true

[runtime_profiles.agent_hive_tier_b]
agentic = true

[runtime_profiles.agent_hive_tier_c]
agentic = true

# ============================================================
# Hive agents
# ============================================================

[agents.hive]
risk_profile = "hive_worker"
model_provider = "groq.default"
runtime_profile = "coordinator"
system_prompt = """
You are a Hive Mind worker. Use bash + filesystem tools to complete the task. Return concise result.
"""

[agents.hive_tier_a]
risk_profile = "hive_worker"
model_provider = "anthropic.opus_4_6"
runtime_profile = "coordinator"
system_prompt = "Hive Mind premium-tier agent. Quality-critical. Use tools to execute completely."

[agents.hive_tier_b]
risk_profile = "hive_worker"
model_provider = "groq.default"
runtime_profile = "coordinator"
system_prompt = "Hive Mind mid-tier worker. Use tools; bash -c for shell."

[agents.hive_tier_c]
risk_profile = "hive_worker"
model_provider = "nvidia.kimi"
runtime_profile = "coordinator"
system_prompt = "Hive Mind routine-tier worker (free NGC). Use tools; bash -c for shell."
