schema_version = 3

# Generated 2026-05-24 — clean v3 native shape.
# Pattern: [providers.models.<type>.<profile>] — one model per profile.
# Multiple profiles per muse for tier selection.

# ============================================================
# Tier A — PREMIUM
# ============================================================

[providers.models.anthropic.opus_4_6]
api_key = "__REPLACE_BY_DEPLOY_SCRIPT__"
model = "claude-opus-4-6"

