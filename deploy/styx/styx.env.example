# /etc/mnemos/styx.env — STYX configuration for ONE host.
# chown root:mnemos, chmod 0640. Contains destination credentials; the age
# value below is a PUBLIC key and is not itself sensitive.

# ── Destination ─────────────────────────────────────────────────────────
# One of: gdrive-service-account (default, no need to set it explicitly),
# r2, rclone. See docs/STYX.md "Choosing a destination" for the tradeoffs.
# Uncomment exactly ONE of the three blocks below to match.
#MNEMOS_STYX_DESTINATION=r2
#MNEMOS_STYX_DESTINATION=rclone

# -- r2: Cloudflare R2 (S3-compatible). No OAuth, just a scoped API token.
# See docs/STYX.md prerequisite 2a for how to create the bucket + token.
#MNEMOS_STYX_R2_ACCOUNT_ID=REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID
#MNEMOS_STYX_R2_BUCKET=mnemos-styx-backups
#MNEMOS_STYX_R2_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
#MNEMOS_STYX_R2_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
# Optional key prefix within the bucket, e.g. if it is ever shared with
# something else (still recommend a dedicated bucket, see docs/STYX.md).
#MNEMOS_STYX_R2_PREFIX=

# -- rclone: any personal remote already set up via `rclone config`. This
# process never touches the underlying credential -- rclone owns it.
# See docs/STYX.md prerequisite 2b.
#MNEMOS_STYX_RCLONE_REMOTE=gdrive-personal:mnemos-backups

# -- gdrive-service-account (default): the original GCP path. A folder in a
# shared drive that the service account has been granted access to. A
# service account's own "My Drive" is not a useful target. See docs/STYX.md
# prerequisite 2c -- real setup overhead vs. r2/rclone above, worth it
# specifically for an independently revocable per-host GCP identity.
MNEMOS_STYX_GDRIVE_FOLDER_ID=REPLACE_WITH_DRIVE_FOLDER_ID

# Either the service-account JSON inline, or a path to it. Prefer the path
# form with systemd LoadCredential so the secret never appears in `systemctl
# show` output or the journal.
MNEMOS_STYX_GDRIVE_CREDENTIALS_JSON=/etc/mnemos/styx-gdrive-sa.json

# ── Encryption ──────────────────────────────────────────────────────────
# PUBLIC recipient only. STYX refuses to start if this is an
# AGE-SECRET-KEY-1... identity, because the private half living on the fleet
# would defeat the entire point: a total fleet loss must not take the ability
# to read these backups with it.
MNEMOS_STYX_AGE_RECIPIENT=age1REPLACE_WITH_PUBLIC_RECIPIENT

# ── Source ──────────────────────────────────────────────────────────────
# 'backend' exports this host's own store in-process with the vault
# included. Use it wherever the store is SQLite.
MNEMOS_STYX_SOURCE_MODE=backend
MNEMOS_STYX_SQLITE_PATH=/var/lib/mnemos/mnemos.sqlite3

# For a pooled backend (Oracle / Postgres / Db2 / MySQL / MariaDB), point
# STYX at THIS host's own service on loopback instead. Non-loopback
# endpoints are refused unless --allow-remote-http is passed, so a typo
# cannot turn per-host STYX into a cross-fleet puller.
#MNEMOS_STYX_SOURCE_MODE=http
#MNEMOS_STYX_HTTP_ENDPOINT=http://127.0.0.1:5002/v1/export
#MNEMOS_STYX_HTTP_TOKEN=REPLACE_WITH_LOCAL_API_TOKEN

# ── Identity + integrity ────────────────────────────────────────────────
# Defaults to the system hostname. Set it explicitly if hostnames change.
#MNEMOS_STYX_HOST_LABEL=pythia

# Refuse to upload an export smaller than this. On the authoritative
# instance raise it close to the real record count: an export that suddenly
# returns 12 records instead of 18,000 is a broken export, not a small one.
MNEMOS_STYX_MIN_RECORDS=1
#MNEMOS_STYX_MIN_BYTES=256

# ── Retention (grandfather-father-son) ──────────────────────────────────
MNEMOS_STYX_RETAIN_DAILY=14
MNEMOS_STYX_RETAIN_WEEKLY=8
MNEMOS_STYX_RETAIN_MONTHLY=12

# Export and encrypt, but never upload or prune. Useful for a first run.
#MNEMOS_STYX_DRY_RUN=1
