[Unit]
Description=Spark relay poller (Spark side) — GCS pending -> NGC exec -> results
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nvidia
WorkingDirectory=/home/nvidia/mnemos
EnvironmentFile=/home/nvidia/.config/spark-relay/relay.env
ExecStart=/home/nvidia/mnemos/.venv/bin/python -m spark_relay.spark_poller --interval 10 --executor ngc
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
