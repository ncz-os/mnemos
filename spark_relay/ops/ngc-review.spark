#!/usr/bin/env python3
"""ngc-review (spark-direct) — cross-family adversarial review gate.

Reads a unified diff on stdin (invoked as `ngc-review -`), sends it to a
cross-family reviewer model on spark's DIRECT NGC endpoint
(inference-api.nvidia.com — spark cannot reach the PYTHIA :4100 caddy proxy),
and exits:
    0 = APPROVE
    1 = NEEDS-ATTENTION
    2 = infra error (fail-open: zc_native_build treats as 'error', pushes flagged)

Cross-family rule: the author family must not review its own output. The author
on spark is claude-opus (ZC_EIH_MODEL=azure/anthropic/claude-opus-4-8), so the
reviewer defaults to an OpenAI-family model (gpt-5.5). Override with
ZC_REVIEW_MODEL_SPARK.
"""
import os
import sys

# Spark reaches NGC ONLY via the public integrate endpoint (integrate.api.nvidia.com).
# The fleet NGC_API_KEY authorizes integrate but NOT inference-api.nvidia.com (401) and
# NOT the PYTHIA :4100 caddy proxy (LAN-unreachable from spark). Default accordingly.
NGC_BASE = os.environ.get("NGC_BASE", "https://integrate.api.nvidia.com/v1").rstrip("/")
NGC_KEY = os.environ.get("NGC_API_KEY", "")
AUTHOR = (os.environ.get("ZC_EIH_MODEL") or os.environ.get("SPARK_AGENTIC_MODEL") or "").lower()

# Cross-family reviewer selection (integrate-valid slugs). The author must not
# review its own family. On spark the native author is a meta/llama model, so the
# reviewer defaults to the OpenAI-family gpt-oss-120b. claude/gpt authors get an
# llama reviewer. Override with ZC_REVIEW_MODEL_SPARK.
if "claude" in AUTHOR or "anthropic" in AUTHOR:
    REVIEWER = os.environ.get("ZC_REVIEW_MODEL_SPARK", "openai/gpt-oss-120b")
elif "openai" in AUTHOR or "gpt" in AUTHOR:
    REVIEWER = os.environ.get("ZC_REVIEW_MODEL_SPARK", "meta/llama-3.3-70b-instruct")
else:
    REVIEWER = os.environ.get("ZC_REVIEW_MODEL_SPARK", "openai/gpt-oss-120b")

SYSTEM = (
    "You are an adversarial code reviewer. The diff must implement EXACTLY the "
    "task and nothing more. Reply NEEDS-ATTENTION if it: reverts or removes "
    "unrelated existing code, adds dead/unwired code (a function/method never "
    "called), changes constants/thresholds outside the task scope, or is "
    "incorrect. Otherwise APPROVE. End with exactly one line: "
    "VERDICT: APPROVE or VERDICT: NEEDS-ATTENTION."
)


def main() -> int:
    diff = sys.stdin.read()
    if not diff.strip():
        print("ngc-review: empty diff", file=sys.stderr)
        return 2
    if not NGC_KEY:
        print("ngc-review: no NGC_API_KEY", file=sys.stderr)
        return 2
    try:
        import requests
    except Exception as e:  # noqa: BLE001
        print(f"ngc-review: requests missing: {e}", file=sys.stderr)
        return 2
    cap = int(os.environ.get("ZC_REVIEW_DIFF_CHARS", "200000"))
    if len(diff) > cap:
        print(f"ngc-review: diff {len(diff)} > {cap} — blocking for human", file=sys.stderr)
        print("VERDICT: NEEDS-ATTENTION")
        return 1
    try:
        resp = requests.post(
            f"{NGC_BASE}/chat/completions",
            headers={"Authorization": f"Bearer {NGC_KEY}"},
            json={
                "model": REVIEWER,
                "messages": [
                    {"role": "system", "content": SYSTEM},
                    {"role": "user", "content": f"DIFF:\n{diff}"},
                ],
                "max_tokens": 1500,
            },
            timeout=float(os.environ.get("ZC_REVIEW_TIMEOUT", "300")),
        )
        resp.raise_for_status()
        txt = resp.json()["choices"][0]["message"]["content"]
    except Exception as e:  # noqa: BLE001
        print(f"ngc-review: infra error (fail-open): {e}", file=sys.stderr)
        return 2
    print(txt)
    # End-anchored verdict: only a clean final VERDICT line counts.
    lines = [ln.strip() for ln in txt.splitlines() if ln.strip()]
    last = lines[-1].upper() if lines else ""
    print(f"ngc-review: reviewer={REVIEWER} verdict_line={last!r}", file=sys.stderr)
    if last == "VERDICT: APPROVE":
        return 0
    if last == "VERDICT: NEEDS-ATTENTION":
        return 1
    # Ambiguous / no clean verdict -> error (fail-open at caller).
    return 2


if __name__ == "__main__":
    sys.exit(main())
