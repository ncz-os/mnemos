# MNEMOS-OS Dockerfile — `full` build (all extras incl. mnemos_hot)
# Multi-stage build with uv for fast dependency resolution

FROM python:3.13-slim as builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ libpq-dev curl git && \
    rm -rf /var/lib/apt/lists/*

# Install a versioned uv installer and verify its bytes before execution.
ARG UV_INSTALLER_SHA256=505407eb4b5bec00e0b231c8c86e968ee3f5aa0136d49dd8a541179e7f76ce7d
RUN curl -fsSL -o /tmp/uv-install.sh https://astral.sh/uv/0.5.11/install.sh && \
    echo "${UV_INSTALLER_SHA256}  /tmp/uv-install.sh" | sha256sum -c - && \
    sh /tmp/uv-install.sh && rm /tmp/uv-install.sh
ENV PATH="/root/.local/bin:$PATH"

COPY pyproject.toml .
COPY requirements.txt .
COPY mnemos ./mnemos

# Base runtime deps
RUN uv pip install --system -r requirements.txt

# Full extras: morpheus, persephone, pantheon, kronos, knossos, apollo,
# artemis (numpy + networkx + scipy), nats, hot (mnemos-hot wheel), edge
RUN uv pip install --system \
    "numpy>=1.24" \
    "scipy>=1.11" \
    "networkx>=3.3" \
    "zstandard>=0.25" \
    "nats-py>=2.14.0" \
    "aiosqlite>=0.20.0" \
    "sqlite-vec>=0.1.6"

# mnemos_hot Rust wheel (not on PyPI — copied from build context)
COPY mnemos_hot-0.2.0-cp311-abi3-manylinux_2_34_x86_64.whl /tmp/
RUN uv pip install --system /tmp/mnemos_hot-0.2.0-cp311-abi3-manylinux_2_34_x86_64.whl && \
    rm /tmp/mnemos_hot-0.2.0-cp311-abi3-manylinux_2_34_x86_64.whl

FROM python:3.13-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /usr/local/lib/python3.13/site-packages /usr/local/lib/python3.13/site-packages

COPY . .

RUN python -m pip install --no-deps --no-build-isolation .

# NB: this `full` image inherits the legacy INFERENCE_EMBED_HOST path that
# expects an external Ollama embedding endpoint. The canonical Dockerfile
# (Postgres-profile) ships the in-process embedder per architectural decision
# mem_1779334716543_f8ebd4 (operator-locked 2026-05-21) and uses
# MNEMOS_EMBED_MODEL_PATH + MNEMOS_EMBED_OV_DEVICE instead. To migrate this
# `full` build to the in-process path, drop INFERENCE_EMBED_HOST and add:
#   MNEMOS_EMBED_MODEL_PATH=/opt/mnemos/models/nomic-embed-text-v1.5.Q8_0.gguf
#   MNEMOS_EMBED_OV_DEVICE=AUTO   # OpenVINO device hint: AUTO | CPU | GPU | NPU
#   OV_CACHE_DIR=/opt/mnemos/ov_cache
# (plus the GGUF download step from the canonical Dockerfile).
# Legacy-embedding deployments set INFERENCE_EMBED_HOST to their own
# reachable Ollama endpoint (e.g. http://localhost:11434). No default
# endpoint is baked in.
ENV PG_USER=mnemos_user \
    PG_DATABASE=mnemos \
    PG_HOST=postgres \
    MNEMOS_BIND=0.0.0.0 \
    MNEMOS_PORT=5002 \
    PYTHONUNBUFFERED=1

RUN useradd --uid 10001 --gid 0 --no-create-home --home-dir /home/mnemos \
      --shell /usr/sbin/nologin mnemos && \
    mkdir -p /home/mnemos /data /opt/mnemos && \
    chown -R 10001:0 /app /home/mnemos /data /opt/mnemos && \
    chmod -R g=u /app /home/mnemos /data /opt/mnemos
USER 10001:0
ENV HOME=/home/mnemos

EXPOSE 5002

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:5002/health').read()" || exit 1

CMD ["mnemos", "serve"]
