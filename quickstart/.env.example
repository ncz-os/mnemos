# Copy to .env and adjust. `docker compose` reads .env automatically.

# Password for the chosen backend (db2inst1 / Oracle system / postgres / mariadb).
# Change it for anything beyond a local trial.
DB_PASSWORD=mnemos_quickstart

# The bundled embedder is CPU bge-m3 (1024-dim), shared by every backend profile.
# To use your own OpenAI-compatible endpoint (Ollama, llama.cpp, hosted), edit the
# `embed` service + the mnemos service's MNEMOS_EMBED_HTTP_* / MNEMOS_EMBEDDING_DIM
# in docker-compose.yml — and keep MNEMOS_EMBEDDING_DIM matched to the model's dim
# (bge-m3 = 1024, nomic-embed-text = 768).
