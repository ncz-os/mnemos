# Copy to .env and adjust. `docker compose` reads .env automatically.

# REQUIRED — password for the chosen backend (db2inst1 / Oracle system / postgres / mariadb).
# There is deliberately NO default baked into docker-compose.yml: you must set your own here,
# so no credential ever lives in the repo. Pick anything for a local trial; use a real secret
# for anything shared. `docker compose` will refuse to start until this is set.
DB_PASSWORD=change-me

# The bundled embedder is CPU bge-m3 (1024-dim), shared by every backend profile.
# To use your own OpenAI-compatible endpoint (Ollama, llama.cpp, hosted), edit the
# `embed` service + the mnemos service's MNEMOS_EMBED_HTTP_* / MNEMOS_EMBEDDING_DIM
# in docker-compose.yml — and keep MNEMOS_EMBEDDING_DIM matched to the model's dim
# (bge-m3 = 1024, nomic-embed-text = 768).
#
# Semantic-recall tuning: MNEMOS_SEMANTIC_FLOOR is the minimum cosine similarity a hit must
# clear (mnemos default 0.65). The bundled *quantized* bge-m3 compresses similarities, so if
# good paraphrases return nothing, lower it (~0.45) and set MNEMOS_SEMANTIC_MARGIN_FLOOR=0 on
# the mnemos service. Re-tune whenever you change the embedder. See docs/BACKENDS.md → Embedder tuning.
